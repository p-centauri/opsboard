# Production settings for the server. Copy to the repo root as `.env` on the server and
# replace every CHANGE_ME. Generate secrets with:  openssl rand -base64 32 | tr -d '/+='
# Never commit the filled-in file.

# Public hostname. Its DNS A/AAAA record must point at this server before the first start,
# so Caddy can obtain the HTTPS certificate.
SITE_ADDRESS=demo.example.com

POSTGRES_USER=opsboard
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=opsboard

# Required on HTTPS: the session cookie is only sent over secure connections.
COOKIE_SECURE=true

# Demo accounts. viewer@demo.local and manager@demo.local use SEED_DEMO_PASSWORD, which is
# shown to visitors through the one-click buttons, so it is public by design.
SEED_DEMO_PASSWORD=CHANGE_ME_PUBLIC_DEMO_PASSWORD
DEMO_PASSWORD=CHANGE_ME_PUBLIC_DEMO_PASSWORD
# admin@demo.local is NOT public: use a long random secret and keep it private.
SEED_ADMIN_PASSWORD=CHANGE_ME
