# Local development values. Copy to .env (make setup does this). Never commit .env.
POSTGRES_USER=opsboard
POSTGRES_PASSWORD=opsboard-dev
POSTGRES_DB=opsboard
DB_PORT=5432
API_PORT=8000

# Passwords for seeded users. viewer@demo.local and manager@demo.local share the demo
# password (it is public on the live demo); admin@demo.local uses its own.
SEED_DEMO_PASSWORD=demo-password
SEED_ADMIN_PASSWORD=change-me-admin
